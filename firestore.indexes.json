{
  "indexes": [
    {
      "//": "claimPlayer: does a pending transfer already exist for this player and team",
      "collectionGroup": "transfers",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "playerId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "toTeamId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Guardian's pending-approval list",
      "collectionGroup": "transfers",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "playerId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "invitePipeline: which player invites exist for this team",
      "collectionGroup": "invites",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "teamId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "type",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "notifyOnBatterUp fan-out: who is linked to this player and opted in",
      "collectionGroup": "members",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "linkedPlayerIds",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "role",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Team schedule and the 'what is live right now' home screen",
      "collectionGroup": "games",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "date",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Cross-org pitching rest check: recent appearances for one arm",
      "collectionGroup": "pitchingAppearances",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "date",
          "order": "DESCENDING"
        },
        {
          "fieldPath": "eligibleAgain",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Settings: pending claims a coach needs to approve",
      "collectionGroup": "claims",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "teamId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "Roster: my own outstanding claim requests",
      "collectionGroup": "claims",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "requestedBy",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "claimPlayer duplicate check",
      "collectionGroup": "claims",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "playerId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "requestedBy",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}