{
  "name": "fanfare-sports",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "test": "node tests/engine.test.js && node tests/finalize.test.js && node tests/invites.test.js && node tests/scoringModes.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "prototype": "node build-prototype.mjs",
    "lint:jsx": "esbuild App.jsx --loader:.jsx=jsx --outfile=/dev/null",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/finalize-web.mjs",
    "deploy:web": "npm run build:web && firebase deploy --only hosting",
    "deploy:backend": "firebase deploy --only firestore:rules,storage:rules,firestore:indexes,functions"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-firebase/app": "^21.6.0",
    "@react-native-firebase/auth": "^21.6.0",
    "@react-native-firebase/firestore": "^21.6.0",
    "@react-native-firebase/functions": "^21.6.0",
    "@react-native-firebase/messaging": "^21.6.0",
    "@react-native-firebase/storage": "^21.6.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo-haptics": "~14.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-device-info": "^14.0.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "firebase": "^11.0.0",
    "react-dom": "18.3.1",
    "react-native-web": "^0.19.13",
    "@expo/metro-runtime": "~4.0.0",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-asset": "~11.0.5",
    "expo-font": "~13.0.4",
    "expo-constants": "~17.0.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "esbuild": "^0.24.2",
    "firebase-tools": "^13.29.0",
    "vitest": "^2.1.8",
    "@babel/core": "^7.25.0",
    "babel-preset-expo": "~12.0.0"
  }
}