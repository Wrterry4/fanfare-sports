# Copy to .env and fill from Firebase Console → Project Settings.
# EXPO_PUBLIC_* values are bundled into the client. They are public
# identifiers, not secrets — access is controlled by Firestore rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Console → Project Settings → Cloud Messaging → Web Push certificates
# → Generate key pair. Required for browser notifications.
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
